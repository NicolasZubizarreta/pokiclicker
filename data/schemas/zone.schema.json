{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graphe des zones d'une région",
  "description": "Format de l'ADR 0002. La dernière étape de chaque zone de combat est son boss. Les liens forment un graphe orienté ; fin autorise une zone sans sortie.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "region", "depart", "premierCombat", "zones", "lieux"],
  "properties": {
    "version": { "const": 1 },
    "region": { "$ref": "#/$defs/identifiant" },
    "depart": { "$ref": "#/$defs/identifiant" },
    "premierCombat": { "$ref": "#/$defs/identifiant", "description": "Identifiant de la première zone de combat." },
    "zones": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/zoneSansCombat" }, { "$ref": "#/$defs/zoneCombat" }] } },
    "lieux": { "type": "array", "items": { "$ref": "#/$defs/lieu" } }
  },
  "$defs": {
    "identifiant": { "type": "string", "minLength": 1 },
    "capture": { "type": "number", "minimum": 0, "maximum": 255 },
    "pokemon": { "type": "integer", "minimum": 1 },
    "condition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["badge", "objet", "quete"] },
            "id": { "$ref": "#/$defs/identifiant" }, "nom": { "type": "string" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "zone"],
          "properties": { "type": { "const": "boss" }, "zone": { "$ref": "#/$defs/identifiant" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "id"],
          "properties": { "type": { "const": "drapeau" }, "id": { "$ref": "#/$defs/identifiant" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["tous"],
          "properties": { "tous": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["un_parmi"],
          "properties": { "un_parmi": { "type": "array", "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["non"],
          "properties": { "non": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "rencontre": {
      "type": "object", "additionalProperties": false, "required": ["pokemon", "nom", "niveau", "capture"],
      "properties": {
        "pokemon": { "$ref": "#/$defs/pokemon" }, "nom": { "type": "string", "minLength": 1 },
        "niveau": { "type": "integer", "minimum": 1 }, "capture": { "$ref": "#/$defs/capture" }
      }
    },
    "lieu": {
      "type": "object", "additionalProperties": false, "required": ["lieu", "nom", "decor", "ancienId", "depuis"],
      "properties": {
        "lieu": { "$ref": "#/$defs/identifiant" },
        "nom": { "type": "string", "minLength": 1 },
        "decor": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^:]+$", "description": "Chemin relatif du futur décor local." },
        "ancienId": { "type": "integer" },
        "depuis": { "$ref": "#/$defs/identifiant" },
        "si": { "$ref": "#/$defs/condition" }
      }
    },
    "zoneSansCombat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nom", "sansCombat", "decor", "liens", "ancienId"],
      "properties": {
        "id": { "$ref": "#/$defs/identifiant" },
        "nom": { "type": "string", "minLength": 1 },
        "sansCombat": { "const": true },
        "message": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "decor": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^:]+$", "description": "Chemin relatif du futur décor local." },
        "liens": { "$ref": "#/$defs/zoneCombat/properties/liens" },
        "ancienId": { "type": "integer" },
        "fin": { "type": "boolean", "description": "Fin de la région ; autorise une zone sans sortie." }
      },
      "if": { "not": { "required": ["fin"], "properties": { "fin": { "const": true } } } },
      "then": { "properties": { "liens": { "minItems": 1 } } }
    },
    "zoneCombat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nom", "decor", "niveaux", "etapes", "multiplicateurPv", "sauvages", "boss", "liens", "ancienId"],
      "properties": {
        "id": { "$ref": "#/$defs/identifiant" },
        "nom": { "type": "string", "minLength": 1 },
        "sansCombat": { "const": false },
        "type": { "enum": ["arene", "ligue"] },
        "decor": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^:]+$", "description": "Chemin relatif du futur décor local." },
        "niveaux": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
          "description": "Niveaux minimum et maximum, dans cet ordre."
        },
        "etapes": { "type": "integer", "minimum": 1, "description": "La dernière étape est le boss ; 10 dans la V1." },
        "multiplicateurPv": { "type": "number", "exclusiveMinimum": 0 },
        "sauvages": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["pokemon", "rarete", "apparition", "capture"],
            "properties": {
              "pokemon": { "$ref": "#/$defs/pokemon" },
              "rarete": { "enum": ["commun", "peu-commun", "rare", "tres-rare", "legendaire"] },
              "apparition": { "type": "number", "exclusiveMinimum": 0 },
              "capture": { "$ref": "#/$defs/capture" }
            }
          }
        },
        "boss": { "$ref": "#/$defs/rencontre" },
        "adversaires": { "type": "array", "items": { "$ref": "#/$defs/rencontre" }, "description": "Adversaires de la Ligue avant le boss, au nombre de etapes moins un." },
        "liens": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["vers"],
            "properties": { "vers": { "$ref": "#/$defs/identifiant" }, "si": { "$ref": "#/$defs/condition" } }
          }
        },
        "ancienId": { "type": "integer" },
        "fin": { "type": "boolean", "description": "Fin de la région ; autorise une zone sans sortie." }
      },
      "allOf": [{
        "if": { "required": ["type"], "properties": { "type": { "const": "ligue" } } },
        "then": { "required": ["adversaires"], "properties": { "sauvages": { "maxItems": 0 } } },
        "else": { "properties": { "sauvages": { "minItems": 1 }, "adversaires": false } }
      }],
      "if": { "not": { "required": ["fin"], "properties": { "fin": { "const": true } } } },
      "then": { "properties": { "liens": { "minItems": 1 } } }
    }
  }
}
